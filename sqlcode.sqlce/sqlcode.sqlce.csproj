<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Sys.Data.SqlCe</RootNamespace>
    <Version>1.1.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(LocalNugetPackages)</PackageOutputPath>
    <PackageId>sqlcode.sqlce</PackageId>
    <Title>SqlCe Agent</Title>
    <Authors>Datconn</Authors>
    <Description>SqlCe for SQL compact edition library</Description>
    <Company>Datconn</Company>
    <Copyright>Copyright 2021-2025</Copyright>
    <PackageProjectUrl>https://github.com/fjiang2/sqlcode</PackageProjectUrl>
    <PackageReleaseNotes>
          9/18/2025 v1.1.0
          Improvements/Enhancements:
          1.
          2.
          Bug Fixes:
          1.
          2.
      </PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net48' ">
    <PackageReference Include="Microsoft.SqlServer.Compact" Version="4.0.8876.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\sqlcode\sqlcode.csproj" />
  </ItemGroup>
</Project>