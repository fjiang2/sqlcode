<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net48</TargetFrameworks>
        <RootNamespace>Sys.Data.SqlClient</RootNamespace>
        <Version>1.1.1</Version>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageOutputPath>$(LocalNugetPackages)</PackageOutputPath>
        <PackageId>sqlcode.sqlclient</PackageId>
        <Title>SqlClient Agent</Title>
        <Authors>Datconn</Authors>
        <Description>SqlClient for SQLServer library</Description>
        <Company>Datconn</Company>
        <Copyright>Copyright 2021-2025</Copyright>
        <PackageProjectUrl>https://github.com/fjiang2/sqlcode</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>
            9/18/2025 v1.1.0
            Improvements/Enhancements:
            1. Support .NET8
            2.
            Bug Fixes:
            1.
            2.
        </PackageReleaseNotes>
    </PropertyGroup>
    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    </ItemGroup>
    <ItemGroup>
        <None Include="docs\README.md" Pack="true" PackagePath="\" />
        <ProjectReference Include="..\sqlcode\sqlcode.csproj" />
    </ItemGroup>
</Project>